# Third-party components bundled into ContainerScope.app (staged by Scripts/fetch-deps.sh).
# Bump a version together with its SHA-256; see docs/developer/dependencies.md.

# Apple container engine: official signed installer, unpacked unmodified into Contents/Resources/Engine.
CONTAINER_VERSION=1.5.0
CONTAINER_PKG_URL=https://github.com/apple/container/releases/download/1.5.0/container-1.5.0-installer-signed.pkg
CONTAINER_PKG_SHA256=a24808cb202318fa1c3bbee0c6c6887fe1225fe899d7b687a0ddd939bd6573f8

# Linux kernel for containers: the engine's recommended Kata Containers build
# (`container system property list` › kernel.url / kernel.binaryPath / kernel.digest).
KATA_VERSION=3.32.0
KATA_URL=https://github.com/kata-containers/kata-containers/releases/download/3.32.0/kata-static-3.32.0-arm64.tar.zst
KATA_SHA256=8736c054d9223974735394f822000823baef509e1c33405ec798240fa9b6e4b5
KERNEL_MEMBER=opt/kata/share/kata-containers/vmlinux-6.18.35-197-debug
KERNEL_VERSION=6.18.35

# QEMU and swtpm: Homebrew bottles, relocated into Contents/Resources/QEMU (versions recorded at staging).
QEMU_FORMULAE="qemu swtpm"
